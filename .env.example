# ============================
# Server
# ============================
NODE_ENV=production
PORT=3000
API_PREFIX=/api/v1
# Dominio único: Nginx sirve la web estática y hace proxy_pass de /api/v1, /uploads y /socket.io
# a este proceso (puerto 3000, solo accesible desde localhost/Nginx, no expuesto a internet).
CLIENT_URL=https://adminclub.thedifference.pro
# Se agregan capacitor://localhost e ionic://localhost para que la app móvil (Capacitor/Ionic)
# pueda seguir hablando con esta misma API en producción.
CLIENT_URLS=https://adminclub.thedifference.pro,capacitor://localhost,ionic://localhost
# Origen público de esta API (protocolo+host, sin puerto porque Nginx expone 443 hacia afuera)
# usado para convertir rutas relativas de /uploads en URLs absolutas.
PUBLIC_URL=https://adminclub.thedifference.pro

# ============================
# Database (MySQL)
# ============================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=admin_club
DB_CONNECTION_LIMIT=10

# ============================
# JWT
# ============================
JWT_ACCESS_SECRET=change_this_access_secret_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=admin-club-api
# Si dejás JWT_ACCESS_SECRET/JWT_REFRESH_SECRET vacíos, el servidor NO arranca salvo que
# pongas explícitamente NODE_ENV=development y este flag en true (usa entonces un secreto de
# desarrollo hardcodeado en el código — NUNCA activar esto fuera de tu máquina local).
# ALLOW_INSECURE_DEV_SECRETS=true

# ============================
# Password reset / email verification tokens
# ============================
RESET_PASSWORD_TOKEN_EXPIRES_MIN=30
VERIFY_EMAIL_TOKEN_EXPIRES_HOURS=48

# ============================
# Security
# ============================
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MIN=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# ============================
# Uploads
# ============================
UPLOAD_MAX_MB=5
UPLOAD_DIR=uploads

# ============================
# Cookies
# ============================
REFRESH_COOKIE_NAME=admin_club_rt
# true en producción: la web corre bajo HTTPS (adminclub.thedifference.pro vía Nginx) y la
# cookie del refresh token debe viajar solo por conexiones seguras.
COOKIE_SECURE=true
# Vacío: web y API quedan bajo el mismo dominio exacto (adminclub.thedifference.pro), así que
# el navegador ya restringe la cookie a ese host sin necesitar declararlo explícitamente. Solo
# hace falta setearlo si la API sirviera subdominios adicionales que deban compartir la cookie.
COOKIE_DOMAIN=

# ============================
# Logs
# ============================
LOG_DIR=logs
LOG_LEVEL=dev

# ============================
# Seed (database/seed.js) — credenciales del Super Admin inicial
# ============================
# Si no se definen, el seed usa admin@adminclub.dev / Admin123! — cambiar SIEMPRE estos valores
# antes de correr `npm run db:seed` contra cualquier entorno que no sea tu máquina local, o el
# Super Admin queda con una contraseña conocida públicamente (está en el código fuente).
SEED_SUPER_ADMIN_EMAIL=admin@adminclub.dev
SEED_SUPER_ADMIN_PASSWORD=Admin123!
